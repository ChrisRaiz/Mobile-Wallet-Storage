# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Leave a platform's values empty and its button shows "Not configured" (demo mode).
#
# Certificates and keys can be pasted as PEM text with \n for line breaks
# (all on one line, inside double quotes), or as base64 of the whole PEM file.

# --- Apple Wallet --------------------------------------------------------------
# From your Apple Developer account: Certificates, Identifiers & Profiles.
APPLE_PASS_TYPE_ID=          # for example pass.com.yourcompany.membership
APPLE_TEAM_ID=               # 10-character Team ID
APPLE_WWDR_CERT=             # Apple WWDR intermediate certificate (G4), PEM
APPLE_SIGNER_CERT=           # Your Pass Type ID certificate, PEM
APPLE_SIGNER_KEY=            # The private key for that certificate, PEM
APPLE_SIGNER_KEY_PASSPHRASE= # Only if the private key is encrypted

# --- Google Wallet -------------------------------------------------------------
# From the Google Pay & Wallet Console and a Google Cloud service account key file.
GOOGLE_ISSUER_ID=              # Numeric issuer ID
GOOGLE_SERVICE_ACCOUNT_EMAIL=  # "client_email" in the key file
GOOGLE_PRIVATE_KEY=            # "private_key" in the key file

# --- Optional ------------------------------------------------------------------
# The site's public HTTPS address. Google Wallet shows the card logo only when it
# can load it from a public URL (served from public/pass-logo.png).
PUBLIC_SITE_URL=
